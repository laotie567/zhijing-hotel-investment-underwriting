* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Repository-only documentation never belongs in a release archive, even if a
# packager archives the repository root by mistake. The production Skill has
# no Git LFS or binary asset; its optional page collector declares its Node
# runtime dependency in the package-local lockfile.
docs export-ignore
docs/** export-ignore
.env.example export-ignore
.gitignore export-ignore
CHANGELOG.md export-ignore
README.md export-ignore
.feishu-e2e-write.* export-ignore
.feishu-e2e-write.*/** export-ignore
# Client office files and page captures are never release artefacts, even if
# someone force-adds one while preparing a repository-root archive.
*.xlsx export-ignore
*.xls export-ignore
*.docx export-ignore
*.doc export-ignore
*.pdf export-ignore
*.png export-ignore
*.jpg export-ignore
*.jpeg export-ignore
*.webp export-ignore
