{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page-collected market evidence request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "target", "search", "pricing_context"],
  "properties": {
    "contract_version": {"const": "market-evidence-collection/v2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "city_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "address": {"type": "string", "minLength": 1, "maxLength": 500},
        "city_id": {"type": "string", "minLength": 1, "maxLength": 40},
        "center": {"$ref": "skill-request.schema.json#/properties/competitor_analysis/properties/confirmed_location"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_profile", "query", "radius_meters"],
      "properties": {
        "provider_profile": {"enum": ["360-map-v1", "ctrip-hotel-v1", "ctrip-live-rates-v1"]},
        "query": {"type": "string", "minLength": 1, "maxLength": 100},
        "radius_meters": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_benchmark_candidates": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_images_per_candidate": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "candidate_inventory": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "benchmark_selected"],
        "properties": {
          "candidate": {"type": "object"},
          "benchmark_selected": {"type": "boolean"},
          "ota_property": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "property_id", "property_url", "match_method", "matched_at"],
            "properties": {
              "platform": {"const": "携程"},
              "property_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "property_url": {"type": "string", "format": "uri"},
              "match_method": {"type": "string", "minLength": 1, "maxLength": 100},
              "matched_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "candidate_pool": {
      "description": "Immutable proof that an OTA Profile received the exact complete 2km map population.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_engine", "source_profile", "center", "candidate_count", "candidate_ids_sha256", "candidate_snapshot_sha256"],
      "properties": {
        "status": {"const": "complete"},
        "source_engine": {"enum": ["playwright", "ego-browser", "kimi-webbridge", "crawl4ai", "xcrawl", "opencli"]},
        "source_profile": {"const": "360-map-v1"},
        "center": {"$ref": "skill-request.schema.json#/properties/competitor_analysis/properties/confirmed_location"},
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "candidate_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pricing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_in_date", "nights", "guests", "currency"],
      "properties": {
        "check_in_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "nights": {"type": "integer", "minimum": 1, "maximum": 30},
        "guests": {"type": "integer", "minimum": 1, "maximum": 12},
        "currency": {"const": "CNY"}
      }
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room_types": {"type": "boolean"},
        "images": {"type": "boolean"},
        "pricing": {"type": "boolean"},
        "benchmark_set": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "search": {
            "properties": {
              "provider_profile": {"enum": ["ctrip-hotel-v1", "ctrip-live-rates-v1"]}
            },
            "required": ["provider_profile"]
          }
        }
      },
      "then": {"required": ["candidate_inventory", "candidate_pool"]}
    }
  ]
}
