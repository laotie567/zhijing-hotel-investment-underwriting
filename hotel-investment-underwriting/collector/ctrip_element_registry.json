{
  "registry_version": "ctrip-element-registry/v1",
  "source_profile": "ctrip-live-rates-v1",
  "roles": {
    "room_container": {
      "semantic_id": "ctrip.captured_room_cards",
      "primary_selectors": ["[data-ctrip-captured-panel='true']"],
      "fallback_selectors": []
    },
    "room_card": {
      "semantic_id": "ctrip.room_card",
      "primary_selectors": ["[class*='commonRoomCard']"],
      "fallback_selectors": []
    },
    "room_name": {
      "semantic_id": "ctrip.room_name",
      "primary_selectors": ["[class*='commonRoomCard-title']"],
      "fallback_selectors": ["[class*='roomName']", "[class*='room-name']"]
    },
    "rate_plan": {
      "semantic_id": "ctrip.rate_plan",
      "primary_selectors": ["[class*='ratePlan']"],
      "fallback_selectors": []
    },
    "price": {
      "semantic_id": "ctrip.price",
      "primary_selectors": ["[class*='price']"],
      "fallback_selectors": []
    },
    "availability": {
      "semantic_id": "ctrip.availability",
      "primary_selectors": ["[class*='book']"],
      "fallback_selectors": []
    },
    "tax_scope": {
      "semantic_id": "ctrip.tax_scope",
      "primary_selectors": ["[class*='tax']"],
      "fallback_selectors": []
    },
    "cancellation": {
      "semantic_id": "ctrip.cancellation",
      "primary_selectors": ["[class*='cancel']"],
      "fallback_selectors": []
    },
    "workstations": {
      "semantic_id": "ctrip.workstations",
      "primary_selectors": ["[class*='room']"],
      "fallback_selectors": []
    }
  }
}
